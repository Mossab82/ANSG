# SYNTHETIC TEST FIXTURE — not CST-Onto. Exercises the ontology inventory and
# cycle detection; every count in it is arbitrary.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix t: <urn:test:inventory#> .

<urn:test:inventory> a owl:Ontology ; owl:versionInfo "synthetic-test-0" .
t:Archetype a owl:Class ; rdfs:label "Archetype"@en .
t:Concept a owl:Class ; rdfs:subClassOf t:Archetype .
t:LoopA a owl:Class ; rdfs:subClassOf t:LoopB ; rdfs:label "A"@en .
t:LoopB a owl:Class ; rdfs:subClassOf t:LoopA ; rdfs:label "B"@en .
t:requiresVirtue a owl:ObjectProperty .
t:contradictsWith a owl:ObjectProperty .
t:dialectalFrequency a owl:DatatypeProperty ; rdfs:range xsd:float .
t:instance1 a owl:NamedIndividual , t:Concept .
t:rule1 a swrl:Imp .
